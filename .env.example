# ==============================================================================
# AI SOCIAL MEDIA MANAGER - COMPLETE ENVIRONMENT CONFIGURATION
# ==============================================================================
# WHATSAPP_DISPLAY_PHONE_NUMBER = Bot's dialable WhatsApp number (with country code)
#   - Example: 923001234567
#   - Used for the wa.me chat link shown in the user dashboard (Admin > Meta Settings can also set it)
WHATSAPP_DISPLAY_PHONE_NUMBER=030329994774

# THIS FILE CONFIGURES THE ENTIRE SAAS PLATFORM:
# - Admin side: Meta credentials, OAuth, settings (6 categories in admin panel)
# - User side: Social account connections (Facebook, Instagram, WhatsApp, Ads)
# - Infrastructure: Database, storage, auth, dev mode
#
# AFTER SETTING: Run `npm run dev` → auto-migrates to DB → Admin panel shows all 6 categories
# ==============================================================================

# ==============================================================================
# META / FACEBOOK / INSTAGRAM / WHATSAPP (ADMIN SETUP)
# ==============================================================================
# Get ALL from: https://developers.facebook.com/apps → your app
#
# === WHATSAPP BUSINESS ===
# Required for: WhatsApp template messages, user WhatsApp connections
#
# WHATSAPP_TOKEN = Your WhatsApp Permanent Access Token
#   - Get from: WhatsApp Manager → Your App → Tokens
#   - Example: EAA... (long lived token)
#   - NEEDED FOR: Admin panel → WhatsApp category, user WhatsApp connections
WHATSAPP_TOKEN=

# WHATSAPP_PHONE_NUMBER_ID = Your WhatsApp Phone Number ID
#   - Get from: WhatsApp Manager → Your App → Phone Numbers
#   - Example: 1234567890
#   - NEEDED FOR: Admin panel → WhatsApp category
WHATSAPP_PHONE_NUMBER_ID=

# WHATSAPP_VERIFY_TOKEN = Webhook verify token
#   - Set same value in Meta Webhook settings
#   - NEEDED FOR: Webhook verification when receiving WhatsApp messages
WHATSAPP_VERIFY_TOKEN=

# WHATSAPP_APP_SECRET = Facebook App Secret for WhatsApp
#   - Get from: developers.facebook.com → Your App → Settings → Basic
#   - Example: abc123def456
#   - NEEDED FOR: Admin panel → WhatsApp category (masked/sensitive)
WHATSAPP_APP_SECRET=

# WHATSAPP_RECIPIENT_PHONE = Test recipient phone number for WhatsApp templates
#   - Example: +1234567890
#   - NEEDED FOR: Testing WhatsApp message templates
WHATSAPP_RECIPIENT_PHONE=

# === INSTAGRAM GRAPH API ===
# Required for: Instagram posts, user Instagram business account connections
#
# INSTAGRAM_ACCESS_TOKEN = Instagram access token
#   - Needs scopes: instagram_basic + instagram_content_publish + pages_manage_posts
#   - Get from: Facebook Graph API OAuth flow with instagram_basic permission
#   - NEEDED FOR: Admin panel → API Versions, user Instagram connections
INSTAGRAM_ACCESS_TOKEN=

# INSTAGRAM_IG_USER_ID = Instagram Business User ID
#   - Get from: Facebook Graph API → /{ig_user_id}
#   - Example: 17841406350707736
#   - NEEDED FOR: User Instagram account connections
INSTAGRAM_IG_USER_ID=

# GRAPH_API_VERSION = Graph API version for all Meta API calls
#   - Default: v21.0 (change if needed for specific features)
#   - NEEDED FOR: Admin panel → General category, API version overrides
GRAPH_API_VERSION=v21.0

# === FACEBOOK GRAPH API ===
# Required for: Facebook Page connections, general Meta integration
#
# FACEBOOK_PAGE_ID = Your Facebook Page ID
#   - Get from: Facebook Page → Settings → Page Info → Page ID
#   - Example: 1234567890123456
#   - NEEDED FOR: User Facebook page connections, posting to FB pages
FACEBOOK_PAGE_ID=

# FACEBOOK_ACCESS_TOKEN = Facebook user access token
#   - Needed for: API calls to Facebook Graph
#   - Short-lived or long-lived token from OAuth
#   - NEEDED FOR: User Facebook connections, page management
FACEBOOK_ACCESS_TOKEN=

# FACEBOOK_APP_ID = Your Meta App ID
#   - Get from: developers.facebook.com → Your App → Settings → Basic
#   - Example: 123456789012345
#   - NEEDED FOR: Admin panel → General category (app identification)
FACEBOOK_APP_ID=

# FACEBOOK_APP_SECRET = Your Meta App Secret
#   - Get from: developers.facebook.com → Your App → Settings → Basic
#   - Example: abc123def456
#   - NEEDED FOR: Admin panel → General category (sensitive, masked in UI)
FACEBOOK_APP_SECRET=

# === META ADS / MARKETING API ===
# Required for: Meta Ads creation, user Ads account connections
#
# META_ADS_ACCOUNT_ID = Your Meta Ads Account ID
#   - Format: act_123456789012345 (with "act_" prefix)
#   - Get from: Meta Ads Manager → Account Settings → Account ID
#   - NEEDED FOR: Admin panel → Meta Ads category, user Ads account connections
META_ADS_ACCOUNT_ID=

# META_ADS_ACCESS_TOKEN = Meta Ads Access Token
#   - Needs scope: ads_management
#   - Get from: Meta Developers → Marketing API → Get Started
#   - Example: ATTA... (long-lived)
#   - NEEDED FOR: Admin panel → Meta Ads category, creating/managing ads
META_ADS_ACCESS_TOKEN=

# ==============================================================================
# OAUTH / AUTHENTICATION (ADMIN + USER)
# ==============================================================================
#
# FACEBOOK_OAUTH_APP_ID = Facebook OAuth App ID (for user Facebook connections)
#   - Get from: developers.facebook.com → Your App → Facebook Login → Settings
#   - NEEDED FOR: Admin panel → OAuth category, users "Connect Facebook"
FACEBOOK_OAUTH_APP_ID=

# FACEBOOK_OAUTH_APP_SECRET = Facebook OAuth App Secret
#   - NEEDED FOR: OAuth callback verification
FACEBOOK_OAUTH_APP_SECRET=

# FACEBOOK_OAUTH_CALLBACK_URL = OAuth redirect URI after user authorizes
#   - Must match exactly what you set in Meta Developer Portal
#   - NEEDED FOR: User Facebook connection flow
FACEBOOK_OAUTH_CALLBACK_URL=http://localhost:8787/api/auth/facebook/callback

# ==============================================================================
# CLAERK (USER AUTHENTICATION - LOGIN/SIGNUP)
# ==============================================================================
#
# CLERK_SECRET_KEY = Clerk Secret Key
#   - Get from: dashboard.clerk.com → Your app → API Keys
#   - Used by backend to verify Clerk session JWTs
#   - NEEDED FOR: User login, signup, authentication flow
CLERK_SECRET_KEY=sk_test_yAK2xsedMLnUR7MUDUIE3RJMuWmEqKOVKERh78vZb6
# CLERK_PUBLISHABLE_KEY = Clerk Publishable Key
#   - Get from: dashboard.clerk.com → Your app → API Keys
#   - Frontend (Vite) reads this as VITE_CLERK_PUBLISHABLE_KEY
#   - NEEDED FOR: User login UI, authentication widgets
CLERK_PUBLISHABLE_KEY=pk_test_aW5jbHVkZWQtaHVtcGJhY2stMzAuY2xlcmsuYWNjb3VudHMuZGV2JA

# The frontend (Vite) reads the publishable key from Frontend/.env as VITE_CLERK_PUBLISHABLE_KEY
# This is auto-set during build - no need to change unless using different Clerk env

# ==============================================================================
# DATABASE & INFRASTRUCTURE
# ==============================================================================
#
# DATABASE_URL = PostgreSQL connection string
#   - Used by: Prisma ORM, all data storage
#   - NEEDED FOR: Platform operation (cannot be empty)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_instagram

# STORAGE_DIR = Local directory for generated images
#   - NEEDED FOR: Image generation pipeline
STORAGE_DIR=./storage

# PUBLIC_BASE_URL = Public URL where images are hosted
#   - Instagram fetches images from here
#   - Use ngrok/railway/render tunnel for production
#   - NEEDED FOR: Instagram post image hosting
PUBLIC_BASE_URL=http://localhost:8787

# ==============================================================================
# APP SETTINGS
# ==============================================================================
#
# PORT = Backend server port
PORT=8787

# WEBHOOK_PATH = Webhook endpoint path
#   - Full URL: http://localhost:8787/webhooks/whatsapp
WEBHOOK_PATH=/webhooks/whatsapp

# LOG_LEVEL = Log verbosity: debug, info, warn, error
LOG_LEVEL=info

# ==============================================================================
# RETRY / RELIABILITY
# ==============================================================================
#
# RETRY_ATTEMPTS = Number of retry attempts for failed API calls
RETRY_ATTEMPTS=3

# RETRY_BASE_DELAY_MS = Base delay in milliseconds between retries
RETRY_BASE_DELAY_MS=800

# HTTP_TIMEOUT_MS = HTTP request timeout in milliseconds (60 seconds)
HTTP_TIMEOUT_MS=60000

# ==============================================================================
# ADMIN SETTINGS (Populated via Admin Panel)
# ==============================================================================
# These are NOT in .env - they are managed via Admin → Meta Settings UI:
#
# General Category:
#   - App ID, App Secret, Graph API Version (edited in admin panel)
#
# OAuth Category:
#   - OAuth Callback URI (edited in admin panel)
#
# Webhook Category:
#   - Verify Token, Webhook Secret (edited in admin panel)
#
# WhatsApp Category:
#   - Access Token, Phone Number ID, OTP/Welcome Templates (edited in admin panel)
#
# API Versions Category:
#   - Facebook/IG/Ads API Version overrides (edited in admin panel)
#
# Meta Ads Category:
#   - Ads Account ID, Ads Access Token (edited in admin panel)
#
# All values are AES-256-GCM encrypted before DB storage
# Super Admin only can view/edit these settings
# Click "Test All" in admin panel to verify all connections

# ==============================================================================
# DEVELOPMENT MODE
# ==============================================================================
#
# DEV_MODE = Set to TRUE for local development only
#   - When TRUE: external services (stripe, whatsapp, image, publish, connect, STT)
#     are MOCKED when their real key is missing
#   - Set to FALSE for production
#   - NEEDED FOR: Development vs production behavior
DEV_MODE=true

# ==============================================================================
# LLM / AI PROVIDER CONFIGURATION
# ==============================================================================
#
# LLM_API_KEY = Mistral AI API Key
#   - Get from: https://console.mistral.ai/
#   - Example: sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   - NEEDED FOR: AI-generated webchat responses, content planning, image prompts
#   - Set to empty to use static default replies (DEV_MODE fallback)
LLM_API_KEY=

# FRONTEND_URL = Frontend development URL
#   - Used for API redirects, OAuth callbacks
FRONTEND_URL=http://localhost:5173

# ==============================================================================
# WHAT TO FILL IN .env vs Admin Panel vs USER
# ==============================================================================
#
# .env FILE (This file) - Fill ONCE at setup:
#   [x] WHATSAPP_TOKEN
#   [x] WHATSAPP_PHONE_NUMBER_ID
#   [x] WHATSAPP_VERIFY_TOKEN
#   [x] WHATSAPP_APP_SECRET
#   [x] WHATSAPP_RECIPIENT_PHONE
#   [x] INSTAGRAM_ACCESS_TOKEN
#   [x] INSTAGRAM_IG_USER_ID
#   [x] GRAPH_API_VERSION
#   [x] FACEBOOK_PAGE_ID
#   [x] FACEBOOK_ACCESS_TOKEN
#   [x] FACEBOOK_APP_ID
#   [x] FACEBOOK_APP_SECRET
#   [x] META_ADS_ACCOUNT_ID
#   [x] META_ADS_ACCESS_TOKEN
#   [x] CLERK_SECRET_KEY
#   [x] CLERK_PUBLISHABLE_KEY
#   [x] DATABASE_URL
#   [x] DEV_MODE
#   [x] FRONTEND_URL
#
# ADMIN PANEL (http://localhost:8787/admin/meta-settings) - Edit as needed:
#   [ ] All 6 categories: General, OAuth, Webhook, WhatsApp, API Versions, Meta Ads
#   [ ] Values can be edited anytime by Super Admin
#   [ ] "Test All" button verifies all connections
#
# USERS (Per user, no technical setup needed):
#   [ ] Click "Connect Facebook" → OAuth → Authorize → Done
#   [ ] Click "Connect WhatsApp" → Enter Phone → OTP → Done
#   [ ] Click "Connect Ads Account" → Authorize → Done
#   [ ] After connected: Posts/Ads use their tokens automatically
#
# ==============================================================================
