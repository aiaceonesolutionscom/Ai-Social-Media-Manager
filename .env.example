# ---- Meta WhatsApp Cloud API ----
# Get from: https://developers.facebook.com/apps → your app → WhatsApp → API credentials
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_RECIPIENT_PHONE=

# ---- Meta Instagram Graph API ----
# Instagram Business account linked to a Facebook Page
# Access token needs instagram_basic + instagram_content_publish + pages_manage_posts scopes
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_IG_USER_ID=
GRAPH_API_VERSION=v21.0

# ---- Speech-to-text (Groq Whisper) ----
# Get from: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---- LLM (content pipeline: intent → plan → caption → image prompt) ----
# Mistral (recommended) — https://console.mistral.ai/
LLM_API_KEY=
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=mistral-large-latest
# Alternative: DeepSeek (cheaper) — https://platform.deepseek.com
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# ---- Image generation ----
# openai uses gpt-image-1; image_url must be publicly fetchable by Instagram
IMAGE_MODEL=gpt-image-1-mini
OPENAI_API_KEY=
# GEMINI_API_KEY=   # uncomment to use Gemini
# STABILITY_API_KEY=  # uncomment to use Stability

# ---- PostgreSQL ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_instagram

# ---- Storage ----
STORAGE_DIR=./storage
# IMPORTANT: must be a PUBLIC HTTPS URL (Instagram fetches the image from here)
# Use ngrok/railway/render/tunnel when testing/live, e.g. https://abcd1234.ngrok.app
PUBLIC_BASE_URL=http://localhost:8787

# ---- App ----
PORT=8787
WEBHOOK_PATH=/webhooks/whatsapp
LOG_LEVEL=info

# ---- Retry / reliability ----
RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_MS=800
HTTP_TIMEOUT_MS=60000

# ---- Admin ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
SUPER_ADMIN_PHONE=

# ---- Facebook ----
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---- Meta Ads ----
META_ADS_ACCOUNT_ID=
META_ADS_ACCESS_TOKEN=

# ---- Stripe ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ---- OAuth (User Authentication) ----
# Google OAuth: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8787/api/auth/google/callback

# Facebook OAuth: https://developers.facebook.com/apps
FACEBOOK_OAUTH_APP_ID=
FACEBOOK_OAUTH_APP_SECRET=
FACEBOOK_OAUTH_CALLBACK_URL=http://localhost:8787/api/auth/facebook/callback

# GitHub OAuth: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8787/api/auth/github/callback

# ---- Clerk (external auth) ----
# Get from: https://dashboard.clerk.com → your app → API Keys
# Secret key is used by the backend to verify Clerk session JWTs
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# The frontend (Vite) reads the publishable key from Frontend/.env as VITE_CLERK_PUBLISHABLE_KEY

# ---- DEV MODE ----
# Testing ONLY: external services (stripe, whatsapp, image, publish, connect, STT) are mocked
# when their real key is missing. Set to true only for local testing. Keep FALSE in production.
DEV_MODE=false
